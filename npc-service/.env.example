# ==============================================================================
# Elastic Worlds - NPC Autonomous Service (Behavior Tree Bots)
# ==============================================================================

# HTTP REST API Server
NPC_HTTP_PORT=5001
NPC_HTTP_HOST=0.0.0.0

# How this replica gets worlds: 'leases' claims them from the Lobby's PostgreSQL
# (worlds started through the Lobby with STORAGE_MODE=rds); 'standalone' has no
# database and only auto-spawns bots for WORLD_WS_URL.
NPC_ASSIGNMENT_MODE=standalone
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudgame
DB_USER=postgres
DB_PASSWORD=postgres
# In AWS the password comes from the secret RDS manages, and TLS uses the RDS CA bundle in the image:
# DB_SECRET_ARN=
# DB_CA_FILE=/app/rds-ca.pem
RECONCILE_INTERVAL_SECONDS=3
LEASE_TTL_SECONDS=15
MAX_WORLDS_PER_TASK=10
CLAIM_BATCH=2

# Target World Service WebSocket Connection (Default fallback)
WORLD_WS_URL=ws://localhost:8001
AUTO_SPAWN_DEFAULT_WORLD=false

# Bot Identity & Scaling
BOT_NAME_PREFIX=[NPC] Guardian
BOT_COUNT=2

# Tick Rates and Timeouts
DECISION_TICK_RATE_HZ=10
RECONNECT_DELAY_SECONDS=3.0

# Tactical & Combat Behavior Parameters
BOT_COMBAT_RANGE=240.0
BOT_OPTIMAL_DISTANCE=170.0
BOT_FLEE_HEALTH_THRESHOLD=35.0
BOT_HEAL_HEALTH_THRESHOLD=80.0
BOT_HARVEST_MAX_RANGE=55.0

# Logging Verbosity ('DEBUG', 'INFO', 'WARNING', 'ERROR')
LOG_LEVEL=INFO

# Telemetry push to the Kinesis pipeline (see .docs/telemetry-pipeline.md)
TELEMETRY_MODE=none
TELEMETRY_STREAM_NAME=elastic-worlds-telemetry
TELEMETRY_INTERVAL_SECONDS=5
AWS_REGION=us-east-1
