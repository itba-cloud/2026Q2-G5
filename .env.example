# ==============================================================================
# Elastic Worlds - Master Environment Configuration Template
# Copy this file to each module's .env or run locally with default settings
# ==============================================================================

# --- Lobby Service (Control Plane API) ---
LOBBY_PORT=3000
LOBBY_HOST=0.0.0.0
PUBLIC_HOST=localhost
# Dirección interna de los World Hosts. En AWS es la IP PRIVADA: PUBLIC_HOST arma la
# wsUrl de los jugadores, pero no es alcanzable desde la subred privada del Lobby.
# Si se deja vacío cae a PUBLIC_HOST (correcto en local).
PRIVATE_HOST=
PUBLIC_WS_PROTOCOL=ws
STORAGE_MODE=local
DATA_DIR=./.lobby_data
# The Lobby forwards these to every world container. Use local only for an
# isolated development world; deployed worlds persist snapshots in S3.
WORLD_STORAGE_MODE=s3
S3_BUCKET_NAME=elastic-worlds-snapshots
AWS_REGION=us-east-1
S3_PREFIX=worlds
# Solo para RDS local: crea host-primary-01. En AWS los World Hosts se registran solos.
SEED_DEFAULT_HOST=false
WORLD_PORT_MIN=8001
WORLD_PORT_MAX=8050
# Vida de una reserva de inicio/parada antes de que la reconciliacion la libere.
WORLD_START_LEASE_MS=60000
DOCKER_HOST=http://127.0.0.1:2375
USE_DOCKER_MOCK=false
WORLD_IMAGE=agromero/elastic-worlds-world-service:latest
CORS_ORIGINS=*

# --- Cross-World Messaging (Redis Pub/Sub) ---
# Global chat and system announcements travel between world instances over a single
# Redis channel. Locally: docker run -d -p 6379:6379 redis:alpine
# In AWS this is the PRIVATE address of the Redis instance.
# Leave UNSET to use the local default below; set it EMPTY to disable messaging.
# The Lobby forwards this to every world container it launches.
REDIS_URL=redis://127.0.0.1:6379
GLOBAL_CHANNEL=world-events
# Caps on player-authored chat, enforced by the world before a line leaves it
CHAT_MAX_LENGTH=120
CHAT_COOLDOWN_MS=1000
# Cap on operator announcements sent through POST /api/announce
ANNOUNCEMENT_MAX_LENGTH=200

# --- Metrics Service (Monitoring & Cost Dashboard, standalone process) ---
# Runs outside the Lobby so every Lobby replica sees the same time series and the
# same billing ledger. It reads the world/host registry from the Lobby REST API and
# scrapes GET /metrics on each world container plus GET /bots on the NPC service.
# The Lobby never touches it: in AWS the ALB routes /api/metrics* straight to this
# service, and locally the dashboard hits http://localhost:3100 directly.
# NOTE: /metrics is part of the world-service image, so after pulling these changes
# you must rebuild and push the image (docker build -t <user>/elastic-worlds:latest
# ./world-service) or every world will show "SIN RESPUESTA" on the panel.

METRICS_PORT=3100
METRICS_HOST=0.0.0.0
# Credenciales de Basic Auth para acceder a las metricas y al panel
METRICS_USER=admin
METRICS_PASS=cloud2026
# En AWS (Fargate no tiene user-data) la contrasena se lee de S3 al arrancar y pisa METRICS_PASS
# METRICS_PASS_SECRET_ID=arn:aws:secretsmanager:<region>:<account-id>:secret:<project>-metrics-password-...
# Lobby REST API (private address in AWS, or the ALB DNS if the Lobby is replicated)
LOBBY_URL=http://127.0.0.1:3000
LOBBY_TIMEOUT_MS=2000
# CORS_ORIGINS is shared with the Lobby block above. The local scraper reads the
# NPC at NPC_SERVICE_URL (default http://127.0.0.1:5001); in AWS each NPC replica
# reports through Kinesis instead.
# NPC_SERVICE_URL=http://127.0.0.1:5001
METRICS_INTERVAL_MS=5000
METRICS_HISTORY_POINTS=180
METRICS_SCRAPE_TIMEOUT_MS=1500


# Cost model used to attribute infrastructure spend to each world.
# PRICING_INSTANCE_TYPE is the assumed EC2 type for hosts that do not report one.
PRICING_INSTANCE_TYPE=t3.medium
PRICING_EBS_GB=30
PRICING_EBS_GB_MONTH_USD=0.08
PRICING_OVERSIZED_THRESHOLD=0.25
PRICING_UNDERSIZED_THRESHOLD=0.85
PRICING_TARGET_UTILIZATION=0.6
PRICING_MAX_SLOT_GROWTH=4

# --- World Service (Authoritative Game Server Node) ---
WORLD_ID=world-01
WORLD_NAME=Bosque Inicial
PORT=8001
SEED=48291
WORLD_WIDTH=1000
WORLD_HEIGHT=1000
SAVE_INTERVAL_SECONDS=30
IDLE_TIMEOUT=60

# --- Game Client (Web Server) ---
CLIENT_PORT=8080
CLIENT_HOST=0.0.0.0

# --- PostgreSQL / AWS RDS Configuration (When STORAGE_MODE=rds) ---
# El Lobby crea y versiona las tablas al iniciar con STORAGE_MODE=rds.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudgame
DB_USER=dbadmin
DB_PASSWORD=your_secure_password_here
# Solo habilita las pruebas de integracion PostgreSQL. No usar en produccion.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cloudgame

# --- NPC Autonomous Service (Python Behavior Tree Bots) ---
NPC_HTTP_PORT=5001
NPC_HTTP_HOST=0.0.0.0
# standalone: bots only for WORLD_WS_URL (AUTO_SPAWN_DEFAULT_WORLD=true).
# leases: the NPC claims ACTIVE worlds from the Lobby's PostgreSQL (DB_* above),
# which needs the Lobby running with STORAGE_MODE=rds.
NPC_ASSIGNMENT_MODE=standalone
WORLD_WS_URL=ws://localhost:8001
AUTO_SPAWN_DEFAULT_WORLD=false
BOT_NAME_PREFIX=[NPC] Guardian
BOT_COUNT=2
DECISION_TICK_RATE_HZ=10
RECONNECT_DELAY_SECONDS=3.0
BOT_COMBAT_RANGE=240.0
BOT_OPTIMAL_DISTANCE=170.0
BOT_FLEE_HEALTH_THRESHOLD=35.0
BOT_HEAL_HEALTH_THRESHOLD=80.0
BOT_HARVEST_MAX_RANGE=55.0
