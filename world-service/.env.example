# ==============================================================================
# Elastic Worlds - World Service (Authoritative Game Server Node)
# ==============================================================================

# World Instance Identity
WORLD_ID=world-01
WORLD_NAME=Bosque Inicial
PORT=8001
SEED=48291
WORLD_WIDTH=1000
WORLD_HEIGHT=1000

# Persistence & Storage ('s3' in AWS | 'local' only for offline development)
STORAGE_MODE=s3
DATA_DIR=./.data
SAVE_INTERVAL_SECONDS=30
IDLE_TIMEOUT=60

# AWS S3 Settings (Used when STORAGE_MODE=s3)
S3_BUCKET_NAME=elastic-worlds-snapshots
AWS_REGION=us-east-1
S3_PREFIX=worlds

# Database Settings (PostgreSQL / AWS RDS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudgame
DB_USER=dbadmin
DB_PASSWORD=your_secure_password_here

# AI Microservice Endpoint
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=5000

# Control Plane Reporting
LOBBY_API_URL=http://127.0.0.1:3000

# Cross-World Messaging (Redis Pub/Sub)
# Global chat and world lifecycle notices are exchanged over this channel.
# Locally: docker run -d -p 6379:6379 redis:alpine
# Unset => the default below. Set EMPTY => messaging disabled for this world.
REDIS_URL=redis://127.0.0.1:6379
GLOBAL_CHANNEL=world-events
# Limits applied to a player's chat line before it leaves this world
CHAT_MAX_LENGTH=120
CHAT_COOLDOWN_MS=1000

# Telemetry push to the Kinesis pipeline (see .docs/telemetry-pipeline.md)
# 'none' locally; the Lobby sets 'kinesis' on every container it launches in AWS.
TELEMETRY_MODE=none
TELEMETRY_STREAM_NAME=elastic-worlds-telemetry
TELEMETRY_INTERVAL_MS=5000
# Billing session id. Unset => hostname (Docker sets it to the container id).
# CONTAINER_ID=
