# ==============================================================================
# Elastic Worlds - Lobby Service (Control Plane API)
# ==============================================================================

# Server Network Configuration
LOBBY_PORT=3000
LOBBY_HOST=0.0.0.0
PUBLIC_HOST=localhost
PUBLIC_WS_PROTOCOL=ws

# Storage Configuration ('local' for JSON file adapter | 'rds' for PostgreSQL)
STORAGE_MODE=local
DATA_DIR=./.lobby_data
# Solo para RDS local: crea host-primary-01. En AWS los World Hosts se registran solos.
SEED_DEFAULT_HOST=false

# PostgreSQL / AWS RDS Configuration (Used when STORAGE_MODE=rds)
# El Lobby aplica las migraciones pendientes al arrancar.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudgame
DB_USER=dbadmin
DB_PASSWORD=your_secure_password_here

# World Instances Port Range (Assigned dynamically to containers on each host)
WORLD_PORT_MIN=8001
WORLD_PORT_MAX=8050

# How long a start/stop reservation stays valid before reconciliation reclaims it
WORLD_START_LEASE_MS=60000

# Docker Host Integration
# Set to http://127.0.0.1:2375 or remote host endpoint for real container provisioning
DOCKER_HOST=http://127.0.0.1:2375
# Set to 'true' to use simulated mock containers without requiring Docker daemon
USE_DOCKER_MOCK=true
# Image the local Docker launcher starts for each world. In AWS worlds run on
# Fargate and the image comes from the world task definition instead.
WORLD_IMAGE=agromero/elastic-worlds-world-service:latest

# World snapshots. These values are forwarded to each world container; they are
# intentionally separate from STORAGE_MODE, which controls the Lobby repository.
WORLD_STORAGE_MODE=s3
S3_BUCKET_NAME=elastic-worlds-snapshots
AWS_REGION=us-east-1
S3_PREFIX=worlds

# CORS Allowed Origins (Comma-separated or '*')
CORS_ORIGINS=*

# Cross-World Messaging (Redis Pub/Sub)
# The Lobby publishes announcements here (POST /api/announce) and forwards this
# URL to every world container it launches. It never subscribes.
# Unset => the default below. Set EMPTY => /announce answers 503.
REDIS_URL=redis://127.0.0.1:6379
GLOBAL_CHANNEL=world-events
ANNOUNCEMENT_MAX_LENGTH=200

# Telemetry pipeline. Forwarded to every world container as TELEMETRY_MODE,
# TELEMETRY_STREAM_NAME and AWS_REGION. 'none' locally; 'kinesis' in AWS.
WORLD_TELEMETRY_MODE=none
TELEMETRY_STREAM_NAME=elastic-worlds-telemetry
